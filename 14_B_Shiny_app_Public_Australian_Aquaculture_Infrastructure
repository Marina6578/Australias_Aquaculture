server <- function(input, output, session) {

  # --- Filtered detections (single reactive - no leases anywhere) -----------
  fdat <- reactive({
    d <- detections
    if (length(input$sel_realm)    > 0) d <- d %>% filter(realm     %in% input$sel_realm)
    if (length(input$sel_infra)    > 0) d <- d %>% filter(infra_type %in% input$sel_infra)
    if (length(input$sel_state)    > 0) d <- d %>% filter(state     %in% input$sel_state)
    if (length(input$sel_group)    > 0) d <- d %>% filter(group     %in% input$sel_group)
    if (length(input$sel_subgroup) > 0) d <- d %>% filter(subgroup  %in% input$sel_subgroup)
    if (!("ALL" %in% input$sel_species) && length(input$sel_species) > 0)
      d <- d %>% filter(species %in% input$sel_species)
    d
  })
  fdat_df <- reactive({ fdat() %>% st_drop_geometry() })

  # --- Reset button -----------------------------------------------------------
  observeEvent(input$reset_btn, {
    updateCheckboxGroupInput(session, "sel_realm",    selected = choice_realm)
    updateCheckboxGroupInput(session, "sel_infra",    selected = choice_infra_type)
    updateCheckboxGroupInput(session, "sel_state",    selected = choice_state)
    updateCheckboxGroupInput(session, "sel_group",    selected = choice_group)
    updateCheckboxGroupInput(session, "sel_subgroup", selected = choice_subgroup)
    updateSelectizeInput    (session, "sel_species",  selected = "ALL")
    updateRadioButtons      (session, "basemap",      selected = "s2_2021")
  })

  # --- Value boxes ------------------------------------------------------------
  output$vb_n <- renderText({
    format(nrow(fdat()), big.mark = ",")
  })
  output$vb_n_marine <- renderText({
    format(sum(fdat_df()$realm == "Marine", na.rm = TRUE), big.mark = ",")
  })
  output$vb_infra <- renderText({
    v <- sum(fdat_df()$infra_area_km2, na.rm = TRUE)
    paste(format(round(v, 2), big.mark = ",", nsmall = 2), "km2")
  })

  # --- Map --------------------------------------------------------------------
  # EOX Sentinel-2 cloudless annual mosaics - single calendar year per layer,
  # rather than the multi-year Esri World Imagery blend. Attribution is
  # required by EOX's terms of use, see the About tab and the addTiles
  # attribution string below.
  s2_url <- function(year) {
    paste0("https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-", year,
           "_3857/default/g/{z}/{y}/{x}.jpg")
  }
  s2_attribution <- paste(
    "Sentinel-2 cloudless -",
    '<a href="https://s2maps.eu" target="_blank">s2maps.eu</a>',
    "by EOX IT Services GmbH (Contains modified Copernicus Sentinel data,",
    "processed by ESA)")

  add_basemap <- function(map, choice) {
    switch(choice,
      "light"   = map %>% addProviderTiles(providers$CartoDB.Positron,
                                            layerId = "basemap"),
      "dark"    = map %>% addProviderTiles(providers$CartoDB.DarkMatter,
                                            layerId = "basemap"),
      "esri"    = map %>% addProviderTiles(providers$Esri.WorldImagery,
                                            layerId = "basemap"),
      "s2_2021" = map %>% addTiles(s2_url(2021), layerId = "basemap",
                                    attribution = s2_attribution),
      "s2_2022" = map %>% addTiles(s2_url(2022), layerId = "basemap",
                                    attribution = s2_attribution)
    )
  }

  output$map <- renderLeaflet({
    leaflet(options = leafletOptions(minZoom = 3)) %>%
      add_basemap("s2_2021") %>%
      setView(lng = 134, lat = -27, zoom = 4)
  })

  observeEvent(input$basemap, {
    leafletProxy("map") %>%
      removeTiles(layerId = "basemap") %>%
      add_basemap(input$basemap)
  })

  observe({
    d <- fdat()
    leafletProxy("map") %>% clearShapes() %>% clearControls()
    if (nrow(d) == 0) return(NULL)

    hi <- highlightOptions(weight = 2, color = "#333333",
                           fillOpacity = 0.95, bringToFront = TRUE)

    make_popup <- function(x) {
      paste0(
        "<b>State:</b> ",            x$state,          "<br>",
        "<b>Realm:</b> ",            x$realm,          "<br>",
        "<b>Infra type:</b> ",       x$infra_type,     "<br>",
        "<b>Group:</b> ",            x$group,
        ifelse(x$subgroup == "—", "",
               paste0(" (", x$subgroup, ")")),         "<br>",
        "<b>Species:</b> ",          x$species,        "<br>",
        "<b>Infra area (km2):</b> ", round(x$infra_area_km2, 5)
      )
    }

    d_marine <- d %>% filter(realm == "Marine")
    d_land   <- d %>% filter(realm == "Land-based")

    proxy <- leafletProxy("map")

    if (nrow(d_marine) > 0)
      proxy <- proxy %>% addPolygons(
        data = d_marine, fillColor = col_marine, color = "white",
        weight = 0.6, opacity = 0.9, fillOpacity = 0.85,
        popup = make_popup(d_marine), highlightOptions = hi)
    if (nrow(d_land) > 0)
      proxy <- proxy %>% addPolygons(
        data = d_land, fillColor = col_land, color = "white",
        weight = 0.6, opacity = 0.9, fillOpacity = 0.9,
        popup = make_popup(d_land), highlightOptions = hi)

    proxy %>%
      addLegend(
        position = "bottomright",
        colors   = c(col_marine, col_land),
        labels   = c("Marine infrastructure", "Land-based ponds"),
        title    = "Detected infrastructure",
        opacity  = 0.9
      )
  })

  # --- Infrastructure area charts --------------------------------------------
  output$bar_infra_state <- renderPlotly({
    make_stacked_bar(fdat_df(), "state", "realm",
                     "infra_area_km2", "Infrastructure area by state x realm",
                     pal_realm)
  })
  output$bar_infra_realm <- renderPlotly({
    make_bar(fdat_df(), "realm", "infra_area_km2",
             "Infrastructure area by realm", "#4477AA")
  })
  output$bar_infra_species <- renderPlotly({
    make_bar(fdat_df(), "species", "infra_area_km2",
             "Infrastructure area by species", "#44AA99")
  })
  output$bar_infra_group <- renderPlotly({
    make_bar(fdat_df(), "group", "infra_area_km2",
             "Infrastructure area by group", "#DDAA33")
  })
  output$bar_infra_type <- renderPlotly({
    make_bar(fdat_df(), "infra_type", "infra_area_km2",
             "Infrastructure area by type", "#CC6677")
  })
  output$bar_infra_state_only <- renderPlotly({
    make_bar(fdat_df(), "state", "infra_area_km2",
             "Infrastructure area by state", "#88CCAA")
  })

  # --- Summary table ----------------------------------------------------------
  output$summary_table <- renderDT({
    d <- fdat_df() %>%
      group_by(state, realm, infra_type, group, subgroup, species) %>%
      summarise(
        n_detections   = n(),
        infra_area_km2 = round(sum(infra_area_km2, na.rm = TRUE), 4),
        .groups = "drop"
      ) %>%
      arrange(state, realm)

    datatable(d, filter = "top", rownames = FALSE,
              extensions = "Buttons",
              options = list(pageLength = 20, scrollX = TRUE,
                             dom = "Bfrtip", buttons = c("csv", "excel")),
              colnames = c("State","Realm","Infra type",
                           "Group","Subgroup","Species",
                           "N detections","Infra area (km2)")) %>%
      formatStyle("infra_area_km2",
                  background = styleColorBar(
                    c(0, max(d$infra_area_km2, na.rm = TRUE)), "#c8dff0"),
                  backgroundSize = "98% 80%",
                  backgroundRepeat = "no-repeat",
                  backgroundPosition = "center")
  })

  output$records_table <- renderDT({
    d <- fdat_df() %>%
      select(state, realm, infra_type,
             group, subgroup, species,
             infra_area_km2) %>%
      mutate(infra_area_km2 = round(infra_area_km2, 5))

    datatable(d, filter = "top", rownames = FALSE,
              options = list(pageLength = 15, scrollX = TRUE),
              colnames = c("State","Realm","Infra type",
                           "Group","Subgroup","Species",
                           "Infra area (km2)"))
  })
}

# =============================================================================
# 7. RUN
# =============================================================================

shinyApp(ui, server)
