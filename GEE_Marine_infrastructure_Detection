  .select(['VV', 'VH', 'VV_contrast', 'VV_corr', 'VV_ent', 'VV_diss', 'VV_var', 'VV_mean_smoothed', 'VV_sharpened']);

var combinedFeaturesImage = embeddingsImage.addBands(sarFeatures).clip(scanArea);


//CLASSIFY & DISPLAY

print('--- STEP 3: Classifying Search Area ---');

var classification = combinedFeaturesImage.classify(classifier);
var classVis = {min: 0, max: 1, palette: ['00000000', '#00FF00']}; // 0=Transparent, 1=Green

Map.addLayer(scanArea, {color: 'red', fillColor: '00000000'}, 'Scan Area (AOI)');
Map.addLayer(sarComposite, {bands:['VV'], min:-20, max:0}, 'SAR Composite', false);
Map.addLayer(classification.selfMask(), classVis, 'Detected Longlines (Green)');

EXPORT

print('--- STEP 4: Preparing Export Task ---');

Export.image.toDrive({
  image: classification.toByte(), 
  description: 'QLD_Longline_Classification',
  folder: 'GEE_Exports',
  fileNamePrefix: 'QLD_Longlines_2021_2022',
  region: scanArea,
  scale: 10,
  maxPixels: 1e13
});
