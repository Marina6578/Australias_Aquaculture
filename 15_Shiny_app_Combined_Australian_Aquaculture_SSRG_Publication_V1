make_bar <- function(df, group_var, value_var, title,
                     fill_col = "#4477AA", xlab = "km2") {
  d <- df %>%
    filter(!is.na(.data[[group_var]]), !is.na(.data[[value_var]])) %>%
    group_by(label = .data[[group_var]]) %>%
    summarise(total = sum(.data[[value_var]], na.rm = TRUE), .groups = "drop") %>%
    filter(total > 0) %>% arrange(total)
  if (nrow(d) == 0)
    return(plotly_empty(type = "bar") %>%
             layout(title = list(text = title, font = list(size = 12))))
  plot_ly(d,
          x = ~total, y = ~label, type = "bar", orientation = "h",
          marker = list(color = fill_col,
                        line = list(color = "white", width = 0.4))) %>%
    layout(title  = list(text = title, font = list(size = 12), x = 0),
           xaxis  = list(title = xlab, tickformat = ".3f"),
           yaxis  = list(title = "", automargin = TRUE,
                         tickfont = list(size = 10)),
           margin = list(l = 10, r = 10, t = 40, b = 40),
           paper_bgcolor = "rgba(0,0,0,0)", plot_bgcolor = "rgba(0,0,0,0)") %>%
    config(displayModeBar = FALSE)
}

make_stacked_bar <- function(df, group_var, stack_var, value_var,
                             title, pal, xlab = "km2") {
  d <- df %>%
    filter(!is.na(.data[[group_var]]), !is.na(.data[[stack_var]])) %>%
    group_by(grp = .data[[group_var]], stk = .data[[stack_var]]) %>%
    summarise(total = sum(.data[[value_var]], na.rm = TRUE), .groups = "drop") %>%
    filter(total > 0)
  if (nrow(d) == 0)
    return(plotly_empty(type = "bar") %>%
             layout(title = list(text = title, font = list(size = 12))))
  lvl_order <- d %>% group_by(grp) %>% summarise(tot = sum(total)) %>%
    arrange(tot) %>% pull(grp)
  d$grp <- factor(d$grp, levels = lvl_order)
  stk_levs <- unique(d$stk)
  stk_cols <- unname(pal[stk_levs]); stk_cols[is.na(stk_cols)] <- "#AAAAAA"
  p <- plot_ly()
  for (i in seq_along(stk_levs)) {
    sub <- d %>% filter(stk == stk_levs[i])
    p <- add_trace(p, x = sub$total, y = as.character(sub$grp),
                   name = stk_levs[i], type = "bar", orientation = "h",
                   marker = list(color = stk_cols[i]))
  }
  p %>% layout(barmode = "stack",
               title  = list(text = title, font = list(size = 12), x = 0),
               xaxis  = list(title = xlab, tickformat = ".3f"),
               yaxis  = list(title = "", automargin = TRUE,
                             tickfont = list(size = 10)),
               margin = list(l = 10, r = 10, t = 40, b = 40),
               legend = list(orientation = "h", y = -0.18),
               paper_bgcolor = "rgba(0,0,0,0)",
               plot_bgcolor  = "rgba(0,0,0,0)") %>%
    config(displayModeBar = FALSE)
}

