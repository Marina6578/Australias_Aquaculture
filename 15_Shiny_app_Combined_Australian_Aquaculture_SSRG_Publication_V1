clean_geoms <- function(x, target = "MULTIPOLYGON") {
  id_col <- intersect(c("detection_id", "lease_id"), names(x))[1]
  get_ids <- function(i) if (!is.na(id_col)) x[[id_col]][i] else as.character(i)

  # 1. Validate and drop empties
  x <- st_make_valid(x)
  empty <- st_is_empty(x)
  if (any(empty)) {
    message("Dropped ", sum(empty), " empty geometries")
    x <- x[!empty, ]
  }

  # 2. Extract polygons from any GEOMETRYCOLLECTIONs
  gc_idx <- which(st_geometry_type(x) == "GEOMETRYCOLLECTION")
  if (length(gc_idx) > 0) {
    extract_type <- sub("^MULTI", "", target)
    drop_ids <- integer(0)
    for (i in gc_idx) {
      ex <- suppressWarnings(st_collection_extract(x[i, ], extract_type))
      if (nrow(ex) == 0) {
        drop_ids <- c(drop_ids, i)
      } else {
        st_geometry(x)[i] <- suppressWarnings(st_union(ex))
      }
    }
    if (length(drop_ids) > 0) {
      message("Dropped ", length(drop_ids),
              " GEOMETRYCOLLECTION feature(s) with no polygon component: ",
              paste(get_ids(drop_ids), collapse = ", "))
      x <- x[-drop_ids, ]
    }
  }

  # 3. Re-validate, drop empties and non-polygons
  x <- st_make_valid(x)
  x <- x[!st_is_empty(x), ]
  non_poly <- !(st_geometry_type(x) %in% c("POLYGON", "MULTIPOLYGON"))
  if (any(non_poly)) {
    message("Dropped ", sum(non_poly), " non-polygon geometries")
    x <- x[!non_poly, ]
  }

  # 4. Bulk cast first (fast path); fall back to per-row if it fails
  result <- tryCatch(suppressWarnings(st_cast(x, target)),
                     error = function(e) NULL)
  if (!is.null(result)) return(result)

  message("Bulk cast failed — retrying per-row to isolate degenerate geoms...")
  ok <- vapply(seq_len(nrow(x)), function(i) {
    tryCatch({ suppressWarnings(st_cast(x[i, ], target)); TRUE },
             error = function(e) FALSE)
  }, logical(1))
  if (!all(ok)) {
    message("Dropped ", sum(!ok), " degenerate geometries that failed cast: ",
            paste(head(get_ids(which(!ok)), 10), collapse = ", "),
            if (sum(!ok) > 10) paste0(" ...+", sum(!ok) - 10, " more") else "")
    x <- x[ok, ]
  }
  st_cast(x, target)
}

