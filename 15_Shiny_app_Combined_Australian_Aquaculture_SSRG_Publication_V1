    make_bar(fdat_df(), "infra_type", "lease_area_km2",
             "Lease area by type", "#CC6677")
  })

  # --- Summary table ----------------------------------------------------------
  output$summary_table <- renderDT({
    d <- fdat_df() %>%
      group_by(state, realm, status, infra_type, group, subgroup, species) %>%
      summarise(
        n_leases       = n(),
        lease_area_km2 = round(sum(lease_area_km2, na.rm = TRUE), 4),
        infra_area_km2 = round(sum(infra_area_km2, na.rm = TRUE), 4),
        .groups = "drop"
      ) %>%
      arrange(state, realm, status)

    datatable(d, filter = "top", rownames = FALSE,
              extensions = "Buttons",
              options = list(pageLength = 20, scrollX = TRUE,
                             dom = "Bfrtip", buttons = c("csv", "excel")),
              colnames = c("State","Realm","Status","Infra type",
                           "Group","Subgroup","Species",
                           "N leases","Lease area (km2)","Infra area (km2)")) %>%
      formatStyle("infra_area_km2",
                  background = styleColorBar(
                    c(0, max(d$infra_area_km2, na.rm = TRUE)), "#c8dff0"),
                  backgroundSize = "98% 80%",
                  backgroundRepeat = "no-repeat",
                  backgroundPosition = "center")
  })

  output$records_table <- renderDT({
    d <- fdat_df() %>%
      select(lease_id, state, realm, status, infra_type,
             group, subgroup, species,
             lease_area_km2, infra_area_km2) %>%
      mutate(across(c(lease_area_km2, infra_area_km2), ~round(.x, 5)))

    datatable(d, filter = "top", rownames = FALSE,
              options = list(pageLength = 15, scrollX = TRUE),
              colnames = c("Lease ID","State","Realm","Status","Infra type",
                           "Group","Subgroup","Species",
                           "Lease area (km2)","Infra area (km2)"))
  })
}

