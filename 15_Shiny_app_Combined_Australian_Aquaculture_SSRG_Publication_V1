server <- function(input, output, session) {

  # --- Filtered leases (primary reactive) ------------------------------------
  fdat <- reactive({
    d <- leases
    if (length(input$sel_realm)    > 0) d <- d %>% filter(realm     %in% input$sel_realm)
    if (length(input$sel_status)   > 0) d <- d %>% filter(status    %in% input$sel_status)
    if (length(input$sel_infra)    > 0) d <- d %>% filter(infra_type %in% input$sel_infra)
    if (length(input$sel_state)    > 0) d <- d %>% filter(state     %in% input$sel_state)
    if (length(input$sel_group)    > 0) d <- d %>% filter(group     %in% input$sel_group)
    if (length(input$sel_subgroup) > 0) d <- d %>% filter(subgroup  %in% input$sel_subgroup)
    if (!("ALL" %in% input$sel_species) && length(input$sel_species) > 0)
      d <- d %>% filter(species %in% input$sel_species)
    d
  })
  fdat_df <- reactive({ fdat() %>% st_drop_geometry() })

  # --- Filtered detections (tied to visible leases) --------------------------
  fdets <- reactive({
    visible_ids <- fdat()$lease_id
    detections %>% filter(lease_id %in% visible_ids)
  })

  # --- Reset button -----------------------------------------------------------
  observeEvent(input$reset_btn, {
    updateCheckboxGroupInput(session, "sel_realm",    selected = choice_realm)
    updateCheckboxGroupInput(session, "sel_status",   selected = choice_status)
    updateCheckboxGroupInput(session, "sel_infra",    selected = choice_infra_type)
    updateCheckboxGroupInput(session, "sel_state",    selected = choice_state)
    updateCheckboxGroupInput(session, "sel_group",    selected = choice_group)
    updateCheckboxGroupInput(session, "sel_subgroup", selected = choice_subgroup)
    updateSelectizeInput    (session, "sel_species",  selected = "ALL")
    updateRadioButtons      (session, "basemap",      selected = "CartoDB.Positron")
    updateCheckboxInput     (session, "show_dets",    value = TRUE)
  })

  # --- Value boxes ------------------------------------------------------------
  output$vb_n <- renderText({
    format(nrow(fdat()), big.mark = ",")
  })
  output$vb_n_active <- renderText({
    format(sum(fdat_df()$status == "Active", na.rm = TRUE), big.mark = ",")
  })
  output$vb_lease <- renderText({
    v <- sum(fdat_df()$lease_area_km2, na.rm = TRUE)
    paste(format(round(v, 1), big.mark = ",", nsmall = 1), "km2")
  })
  output$vb_infra <- renderText({
    v <- sum(fdat_df()$infra_area_km2, na.rm = TRUE)
    paste(format(round(v, 2), big.mark = ",", nsmall = 2), "km2")
  })

  # --- Map --------------------------------------------------------------------
  output$map <- renderLeaflet({
    leaflet(options = leafletOptions(minZoom = 3)) %>%
      addProviderTiles(providers$CartoDB.Positron, layerId = "basemap") %>%
      setView(lng = 134, lat = -27, zoom = 4)
  })

  # EOX Sentinel-2 cloudless annual mosaics (WMTS, GoogleMapsCompatible grid)
  s2_cloudless_url <- function(year) {
    sprintf("https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-%s_3857/default/g/{z}/{y}/{x}.jpg",
            year)
  }
  s2_cloudless_attr <- function(year) {
    sprintf("Sentinel-2 cloudless %s &copy; <a href='https://s2maps.eu'>EOX IT Services GmbH</a> (contains modified Copernicus Sentinel data %s)",
            year, year)
  }

  observeEvent(input$basemap, {
    proxy <- leafletProxy("map") %>% removeTiles(layerId = "basemap")

    if (input$basemap %in% c("s2_2021", "s2_2022")) {
      yr <- sub("s2_", "", input$basemap)
      proxy %>% addTiles(
        urlTemplate = s2_cloudless_url(yr),
        layerId     = "basemap",
        options     = tileOptions(maxZoom = 14),
        attribution = s2_cloudless_attr(yr)
      )
    } else {
      proxy %>% addProviderTiles(input$basemap, layerId = "basemap")
    }
  })

  observe({
    d <- fdat()
    leafletProxy("map") %>% clearShapes() %>% clearControls()
    if (nrow(d) == 0) return(NULL)

    hi <- highlightOptions(weight = 3, color = "#333333",
                           fillOpacity = 0, bringToFront = TRUE)

    make_popup <- function(x) {
      paste0(
        "<b>Lease ID:</b> ",         x$lease_id,       "<br>",
        "<b>State:</b> ",            x$state,          "<br>",
        "<b>Realm:</b> ",            x$realm,          "<br>",
        "<b>Status:</b> ",           x$status,         "<br>",
        "<b>Infra type:</b> ",       x$infra_type,     "<br>",
        "<b>Group:</b> ",            x$group,
        ifelse(x$subgroup == "—", "",
               paste0(" (", x$subgroup, ")")),         "<br>",
        "<b>Species:</b> ",          x$species,        "<br>",
        "<b>Lease area (km2):</b> ", round(x$lease_area_km2, 4), "<br>",
        "<b>Infra area (km2):</b> ", round(x$infra_area_km2, 4)
      )
    }

    # Four lease sub-layers for clear styling
    d_ma <- d %>% filter(realm == "Marine"     & status == "Active")
    d_mi <- d %>% filter(realm == "Marine"     & status == "Inactive")
    d_la <- d %>% filter(realm == "Land-based" & status == "Active")
    d_li <- d %>% filter(realm == "Land-based" & status == "Inactive")

    proxy <- leafletProxy("map")

    # Inactive first (lighter, bottom) - borders only, no fill, so detections
    # (ponds/cages/longlines) underneath stay visible
    if (nrow(d_mi) > 0)
      proxy <- proxy %>% addPolygons(
        data = d_mi, fillColor = col_mi, color = col_mi,
        weight = 1.4, opacity = 0.9, fillOpacity = 0,
        dashArray = "4 3", popup = make_popup(d_mi),
        highlightOptions = hi)
    if (nrow(d_li) > 0)
      proxy <- proxy %>% addPolygons(
        data = d_li, fillColor = col_li, color = col_li,
        weight = 1.4, opacity = 0.9, fillOpacity = 0,
        dashArray = "4 3", popup = make_popup(d_li),
        highlightOptions = hi)
    # Active on top (darker, solid) - borders only, no fill
    if (nrow(d_ma) > 0)
      proxy <- proxy %>% addPolygons(
        data = d_ma, fillColor = col_ma, color = col_ma,
        weight = 1.6, opacity = 0.95, fillOpacity = 0,
        popup = make_popup(d_ma), highlightOptions = hi)
    if (nrow(d_la) > 0)
      proxy <- proxy %>% addPolygons(
        data = d_la, fillColor = col_la, color = col_la,
        weight = 1.6, opacity = 0.95, fillOpacity = 0,
        popup = make_popup(d_la), highlightOptions = hi)

# Detection overlay
    if (isTRUE(input$show_dets)) {
      dd <- fdets()
      if (nrow(dd) > 0) {
        dd_m <- dd %>% filter(realm == "Marine")
        dd_l <- dd %>% filter(realm == "Land-based")

        det_popup <- function(x) {
          paste0(
            "<b>Detection ID:</b> ", x$detection_id, "<br>",
            "<b>Lease ID:</b> ",     x$lease_id,     "<br>",
            "<b>Realm:</b> ",        x$realm,        "<br>",
            "<b>State:</b> ",        x$state,        "<br>",
            "<b>Infra type:</b> ",   x$infra_type,   "<br>",
            "<b>Species:</b> ",      x$species,      "<br>",
            "<b>Infra area (km2):</b> ",
            round(x$infra_area_km2, 5)
          )
        }

        if (nrow(dd_m) > 0)
          proxy <- proxy %>% addPolygons(
            data        = dd_m,
            fillColor   = "#222266",   # dark navy for marine
            color       = "#222266",
            weight      = 0.4,
            opacity     = 0.9,
            fillOpacity = 0.85,
            popup       = det_popup(dd_m)
          )

        if (nrow(dd_l) > 0)
          proxy <- proxy %>% addPolygons(
            data        = dd_l,
            fillColor   = "#332288",   # deep indigo for land ponds
            color       = "#332288",
            weight      = 0.3,
            opacity     = 0.9,
            fillOpacity = 0.9,
            popup       = det_popup(dd_l)
          )
      }
    }

    # Legend
line_swatch <- function(col, dashed = FALSE) {
      style_bit <- if (dashed) "dashed" else "solid"
      sprintf(
        "<span style='display:inline-block;width:22px;height:0;border-top:3px %s %s;margin-right:5px;vertical-align:middle;'></span>",
        style_bit, col)
    }
    box_swatch <- function(col) {
      sprintf(
        "<span style='display:inline-block;width:12px;height:12px;background:%s;margin-right:5px;vertical-align:middle;'></span>",
        col)
    }
    legend_html <- HTML(paste0(
      "<div style='background:white;padding:7px 11px;border-radius:4px;",
      "box-shadow:0 1px 4px rgba(0,0,0,0.4);font-size:12px;line-height:1.9;'>",
      "<strong>Realm x Status</strong><br>",
      line_swatch(col_ma),          " Marine - Active<br>",
      line_swatch(col_mi, TRUE),    " Marine - Inactive<br>",
      line_swatch(col_la),          " Land-based - Active<br>",
      line_swatch(col_li, TRUE),    " Land-based - Inactive<br>",
      box_swatch("#222266"),        " Detected marine infrastructure<br>",
      box_swatch("#332288"),        " Detected land ponds",
      "</div>"
    ))

    proxy %>%
      addControl(html = legend_html, position = "bottomright", layerId = "legend")
  })

  # --- Infrastructure area charts --------------------------------------------
  output$bar_infra_state <- renderPlotly({
    make_stacked_bar(fdat_df(), "state", "realm",
                     "infra_area_km2", "Infrastructure area by state",
                     pal_realm)
  })
  output$bar_infra_realm <- renderPlotly({
    make_bar(fdat_df(), "realm", "infra_area_km2",
             "Infrastructure area by realm", "#4477AA")
  })
  output$bar_infra_species <- renderPlotly({
    make_bar(fdat_df(), "species", "infra_area_km2",
             "Infrastructure area by species", "#44AA99")
  })
  output$bar_infra_group <- renderPlotly({
    make_bar(fdat_df(), "group", "infra_area_km2",
             "Infrastructure area by group", "#DDAA33")
  })
  output$bar_infra_status <- renderPlotly({
    make_stacked_bar(fdat_df(), "state", "status",
                     "infra_area_km2", "Infrastructure area by status x state",
                     pal_status)
  })
  output$bar_infra_type <- renderPlotly({
    make_bar(fdat_df(), "infra_type", "infra_area_km2",
             "Infrastructure area by type", "#CC6677")
  })

  # --- Lease area charts ------------------------------------------------------
  output$bar_lease_state <- renderPlotly({
    make_stacked_bar(fdat_df(), "state", "realm",
                     "lease_area_km2", "Lease area by state", pal_realm)
  })
  output$bar_lease_realm <- renderPlotly({
    make_bar(fdat_df(), "realm", "lease_area_km2",
             "Lease area by realm", "#4477AA")
  })
  output$bar_lease_species <- renderPlotly({
    make_bar(fdat_df(), "species", "lease_area_km2",
             "Lease area by species", "#44AA99")
  })
  output$bar_lease_group <- renderPlotly({
